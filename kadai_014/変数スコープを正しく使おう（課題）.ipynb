        "\n",
        "price1 = 100\n",
        "price2 = 200\n",
        "\n",
        "def total(tax):\n",
        "    # 商品の合計金額を計算する\n",
        "    subtotal = price1 + price2\n",
        "\n",
        "    # 消費税を加えた金額を返す\n",
        "    return subtotal * tax\n",
        "\n",
        "# 消費税率10%を指定して計算する\n",
        "print(total(1.1))\n"
