      "source": [
        "\n",
        "# 消費税を加えた金額を計算する関数\n",
        "def calculate_tax_price(price, tax_rate):\n",
        "    total_price = price + price * tax_rate / 100\n",
        "    return total_price\n",
        "\n",
        "# 関数を呼び出す（第1引数：商品金額、第2引数：消費税率）\n",
        "result = calculate_tax_price(110, 10)\n",
        "\n",
        "# 計算結果を表示する\n",
        "print(result)\n"
      ]
    }
  ]
}