      "source": [
        "# 下記の台形の面積を計算する\n",
        "上辺 = 10\n",
        "下辺 = 20\n",
        "高さ = 5\n",
        "# 台形の面積の公式: (上辺 + 下辺) *高さ / 2\n",
        "面積 = (上辺 + 下辺 ) * 高さ / 2\n",
        "print(f\"台形の面積は {面積}cm²　です。\")"
      ]
    }
